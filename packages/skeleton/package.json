{
  "name": "@qingwu/skeleton",
  "version": "0.8.0",
  "description": "Qingwu UI Skeleton — runtime DOM-measuring auto skeleton (in-place measurement, portal overlay, compositor-driven shimmer), snapshot-to-static-HTML renderer, zero-dependency",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": [
    "./dist/style.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node -e \"require('fs').cpSync('src/style.css','dist/style.css')\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "size-limit"
  },
  "devDependencies": {
    "@qingwu/tsconfig": "workspace:*",
    "@qingwu/text-layout": "workspace:*",
    "@size-limit/preset-small-lib": "^13.0.1",
    "size-limit": "^13.0.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "size-limit": [
    {
      "path": "dist/index.mjs",
      "limit": "8 kB"
    }
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/apricotdream/qingwu-ui.git",
    "directory": "packages/skeleton"
  },
  "homepage": "https://github.com/apricotdream/qingwu-ui#readme",
  "bugs": "https://github.com/apricotdream/qingwu-ui/issues",
  "keywords": [
    "skeleton",
    "shimmer",
    "loading",
    "skeleton-loader",
    "auto-skeleton",
    "ui-component",
    "framework-agnostic",
    "qingwu"
  ],
  "author": "Qingwu Team",
  "engines": {
    "node": ">=20"
  }
}
