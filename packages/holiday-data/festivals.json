[
  {
    "id": "spring-festival",
    "name": "春节",
    "rule": {
      "calendar": "lunar",
      "month": 1,
      "day": 1
    },
    "description": {
      "text": "农历新年的重要节日，寄托团圆与辞旧迎新的愿望。",
      "sources": [
        {
          "title": "春节",
          "publisher": "北京市人民政府",
          "url": "https://www.beijing.gov.cn/renwen/zt/wmdjr/cj/202303/t20230314_2936365.html",
          "accessedAt": "2026-10-25"
        }
      ]
    },
    "origin": {
      "text": "传统年节在长期的岁时生活中形成，庆祝时间与地方习惯有所差异。",
      "sources": [
        {
          "title": "春节",
          "publisher": "北京市人民政府",
          "url": "https://www.beijing.gov.cn/renwen/zt/wmdjr/cj/202303/t20230314_2936365.html",
          "accessedAt": "2026-10-25"
        }
      ]
    },
    "customs": {
      "text": "家人团聚、拜年、贴春联、守岁等。",
      "sources": [
        {
          "title": "春节",
          "publisher": "北京市人民政府",
          "url": "https://www.beijing.gov.cn/renwen/zt/wmdjr/cj/202303/t20230314_2936365.html",
          "accessedAt": "2026-10-25"
        }
      ]
    }
  },
  {
    "id": "lantern-festival",
    "name": "元宵节",
    "rule": {
      "calendar": "lunar",
      "month": 1,
      "day": 15
    },
    "description": {
      "text": "农历正月十五的传统节日，又称上元节。",
      "sources": [
        {
          "title": "元宵节",
          "publisher": "北京市人民政府",
          "url": "https://www.beijing.gov.cn/renwen/zt/wmdjr/yxj/202303/t20230303_2928272.html",
          "accessedAt": "2026-10-25"
        }
      ]
    },
    "origin": {
      "text": "元宵赏灯在长期的岁时庆典中逐步发展，各地形成不同灯会传统。",
      "sources": [
        {
          "title": "元宵节",
          "publisher": "北京市人民政府",
          "url": "https://www.beijing.gov.cn/renwen/zt/wmdjr/yxj/202303/t20230303_2928272.html",
          "accessedAt": "2026-10-25"
        }
      ]
    },
    "customs": {
      "text": "赏灯、猜灯谜，吃元宵或汤圆。",
      "sources": [
        {
          "title": "元宵节",
          "publisher": "北京市人民政府",
          "url": "https://www.beijing.gov.cn/renwen/zt/wmdjr/yxj/202303/t20230303_2928272.html",
          "accessedAt": "2026-10-25"
        }
      ]
    }
  },
  {
    "id": "dragon-head",
    "name": "龙抬头",
    "rule": {
      "calendar": "lunar",
      "month": 2,
      "day": 2
    },
    "description": {
      "text": "农历二月初二的民俗节日，与春耕和祈愿丰收有关。",
      "sources": [
        {
          "title": "“二月二”龙抬头的民俗",
          "publisher": "上海市虹口区人民政府",
          "url": "https://www.shhk.gov.cn/xwzx/002008/002008040/20240312/cb401e90-eb94-4729-aaaf-f677c6fe6c3c.html",
          "accessedAt": "2026-10-25"
        }
      ]
    },
    "origin": {
      "text": "与农时、降雨和龙的文化意象相联系；相关龙王故事属于民间传说。",
      "sources": [
        {
          "title": "“二月二”龙抬头的民俗",
          "publisher": "上海市虹口区人民政府",
          "url": "https://www.shhk.gov.cn/xwzx/002008/002008040/20240312/cb401e90-eb94-4729-aaaf-f677c6fe6c3c.html",
          "accessedAt": "2026-10-25"
        }
      ]
    },
    "customs": {
      "text": "部分地区有理发、食用带“龙”名食物等习俗。",
      "sources": [
        {
          "title": "“二月二”龙抬头的民俗",
          "publisher": "上海市虹口区人民政府",
          "url": "https://www.shhk.gov.cn/xwzx/002008/002008040/20240312/cb401e90-eb94-4729-aaaf-f677c6fe6c3c.html",
          "accessedAt": "2026-10-25"
        }
      ]
    }
  },
  {
    "id": "dragon-boat",
    "name": "端午节",
    "rule": {
      "calendar": "lunar",
      "month": 5,
      "day": 5
    },
    "description": {
      "text": "农历五月初五的传统节日，又称端阳。",
      "sources": [
        {
          "title": "端午节",
          "publisher": "北京市人民政府",
          "url": "https://www.beijing.gov.cn/renwen/zt/wmdjr/dwj/202303/t20230303_2928401.html",
          "accessedAt": "2026-10-25"
        }
      ]
    },
    "origin": {
      "text": "具有禳灾祈福等多种文化内涵；纪念屈原是广泛流传的一种叙事，各地还有其他传说。",
      "sources": [
        {
          "title": "端午节",
          "publisher": "北京市人民政府",
          "url": "https://www.beijing.gov.cn/renwen/zt/wmdjr/dwj/202303/t20230303_2928401.html",
          "accessedAt": "2026-10-25"
        }
      ]
    },
    "customs": {
      "text": "赛龙舟、吃粽子、悬挂艾草等，地域习俗各有不同。",
      "sources": [
        {
          "title": "端午节",
          "publisher": "北京市人民政府",
          "url": "https://www.beijing.gov.cn/renwen/zt/wmdjr/dwj/202303/t20230303_2928401.html",
          "accessedAt": "2026-10-25"
        }
      ]
    }
  },
  {
    "id": "qixi",
    "name": "七夕节",
    "rule": {
      "calendar": "lunar",
      "month": 7,
      "day": 7
    },
    "description": {
      "text": "农历七月初七，又称乞巧节、女儿节。",
      "sources": [
        {
          "title": "七夕节",
          "publisher": "中国非物质文化遗产网·中国非物质文化遗产数字博物馆",
          "url": "https://www.ihchina.cn/Article/Index/detail?id=14926",
          "accessedAt": "2026-10-25"
        }
      ]
    },
    "origin": {
      "text": "与织女信仰及乞巧活动有关；牛郎织女鹊桥相会属于民间传说。",
      "sources": [
        {
          "title": "七夕节",
          "publisher": "中国非物质文化遗产网·中国非物质文化遗产数字博物馆",
          "url": "https://www.ihchina.cn/Article/Index/detail?id=14926",
          "accessedAt": "2026-10-25"
        }
      ]
    },
    "customs": {
      "text": "穿针乞巧、制作巧果等，具体活动因地区而异。",
      "sources": [
        {
          "title": "七夕节",
          "publisher": "中国非物质文化遗产网·中国非物质文化遗产数字博物馆",
          "url": "https://www.ihchina.cn/Article/Index/detail?id=14926",
          "accessedAt": "2026-10-25"
        }
      ]
    }
  },
  {
    "id": "zhongyuan",
    "name": "中元节",
    "rule": {
      "calendar": "lunar",
      "month": 7,
      "day": 15
    },
    "description": {
      "text": "俗称“七月半”，是部分地区追思先人的民俗时节。",
      "sources": [
        {
          "title": "中元节习俗",
          "publisher": "天门市人民政府",
          "url": "https://www.tianmen.gov.cn/zjtm/tmwh/tmms/201604/t20160419_1930964.shtml",
          "accessedAt": "2026-10-25"
        }
      ]
    },
    "origin": {
      "text": "祖先祭祀与相关宗教文化长期交融，过节日期和形式存在地域差异。",
      "sources": [
        {
          "title": "中元节习俗",
          "publisher": "天门市人民政府",
          "url": "https://www.tianmen.gov.cn/zjtm/tmwh/tmms/201604/t20160419_1930964.shtml",
          "accessedAt": "2026-10-25"
        }
      ]
    },
    "customs": {
      "text": "部分地区有祭祖、追思等活动，资料描述的是当地民俗。",
      "sources": [
        {
          "title": "中元节习俗",
          "publisher": "天门市人民政府",
          "url": "https://www.tianmen.gov.cn/zjtm/tmwh/tmms/201604/t20160419_1930964.shtml",
          "accessedAt": "2026-10-25"
        }
      ]
    }
  },
  {
    "id": "mid-autumn",
    "name": "中秋节",
    "rule": {
      "calendar": "lunar",
      "month": 8,
      "day": 15
    },
    "description": {
      "text": "农历八月十五，以赏月、团圆为重要主题。",
      "sources": [
        {
          "title": "中秋节",
          "publisher": "北京市人民政府",
          "url": "https://www.beijing.gov.cn/renwen/zt/wmdjr/zqj/202303/t20230303_2928408.html",
          "accessedAt": "2026-10-25"
        }
      ]
    },
    "origin": {
      "text": "与古代秋祀、拜月传统有关，后发展为广泛庆祝的节日；嫦娥奔月属于神话传说。",
      "sources": [
        {
          "title": "中秋节",
          "publisher": "北京市人民政府",
          "url": "https://www.beijing.gov.cn/renwen/zt/wmdjr/zqj/202303/t20230303_2928408.html",
          "accessedAt": "2026-10-25"
        }
      ]
    },
    "customs": {
      "text": "赏月、吃月饼、家人团聚。",
      "sources": [
        {
          "title": "中秋节",
          "publisher": "北京市人民政府",
          "url": "https://www.beijing.gov.cn/renwen/zt/wmdjr/zqj/202303/t20230303_2928408.html",
          "accessedAt": "2026-10-25"
        }
      ]
    }
  },
  {
    "id": "double-ninth",
    "name": "重阳节",
    "rule": {
      "calendar": "lunar",
      "month": 9,
      "day": 9
    },
    "description": {
      "text": "农历九月初九的传统节日，也承载敬老主题。",
      "sources": [
        {
          "title": "重阳节",
          "publisher": "北京市人民政府",
          "url": "https://www.beijing.gov.cn/renwen/zt/wmdjr/cyj/202303/t20230303_2928420.html",
          "accessedAt": "2026-10-25"
        }
      ]
    },
    "origin": {
      "text": "“九九”重叠得名，传统岁时活动逐步形成登高、赏菊等风俗。",
      "sources": [
        {
          "title": "重阳节",
          "publisher": "北京市人民政府",
          "url": "https://www.beijing.gov.cn/renwen/zt/wmdjr/cyj/202303/t20230303_2928420.html",
          "accessedAt": "2026-10-25"
        }
      ]
    },
    "customs": {
      "text": "登高、赏菊、吃重阳糕、敬老。",
      "sources": [
        {
          "title": "重阳节",
          "publisher": "北京市人民政府",
          "url": "https://www.beijing.gov.cn/renwen/zt/wmdjr/cyj/202303/t20230303_2928420.html",
          "accessedAt": "2026-10-25"
        }
      ]
    }
  },
