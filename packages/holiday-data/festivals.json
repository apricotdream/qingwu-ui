      "sources": [
        {
          "title": "春节古时称“元旦”",
          "publisher": "北京市人民政府",
          "url": "https://www.beijing.gov.cn/renwen/pjsx/201902/t20190201_1874837.html",
          "accessedAt": "2026-10-25"
        },
        {
          "title": "“我们的节日”东城区非遗主题系列活动——腊八节",
