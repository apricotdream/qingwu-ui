          "accessedAt": "2026-10-25"
        }
      ]
    }
  },
  {
    "id": "little-new-year-north",
    "name": "小年（北）",
    "rule": {
      "calendar": "lunar",
      "month": 12,
      "day": 23
    },
    "description": {
      "text": "北方不少地区在腊月二十三过小年。",
      "sources": [
        {
          "title": "春节古时称“元旦”",
          "publisher": "北京市人民政府",
          "url": "https://www.beijing.gov.cn/renwen/pjsx/201902/t20190201_1874837.html",
          "accessedAt": "2026-10-25"
        }
      ]
    },
    "origin": {
      "text": "与传统祭灶活动相联系；灶神上天的故事属于民间信仰与传说。",
      "sources": [
        {
          "title": "春节古时称“元旦”",
          "publisher": "北京市人民政府",
          "url": "https://www.beijing.gov.cn/renwen/pjsx/201902/t20190201_1874837.html",
          "accessedAt": "2026-10-25"
        }
      ]
    },
    "customs": {
      "text": "祭灶、扫尘、准备年货等，各地并不完全相同。",
      "sources": [
        {
          "title": "春节古时称“元旦”",
          "publisher": "北京市人民政府",
          "url": "https://www.beijing.gov.cn/renwen/pjsx/201902/t20190201_1874837.html",
          "accessedAt": "2026-10-25"
        }
      ]
    }
  },
  {
    "id": "little-new-year-south",
    "name": "小年（南）",
    "rule": {
      "calendar": "lunar",
      "month": 12,
      "day": 24
    },
    "description": {
      "text": "南方部分地区在腊月二十四过小年。",
      "sources": [
        {
          "title": "春节古时称“元旦”",
          "publisher": "北京市人民政府",
          "url": "https://www.beijing.gov.cn/renwen/pjsx/201902/t20190201_1874837.html",
          "accessedAt": "2026-10-25"
        }
      ]
    },
    "origin": {
      "text": "各地的小年日期并不统一，与地方祭灶传统有关。",
      "sources": [
        {
          "title": "春节古时称“元旦”",
          "publisher": "北京市人民政府",
          "url": "https://www.beijing.gov.cn/renwen/pjsx/201902/t20190201_1874837.html",
          "accessedAt": "2026-10-25"
        }
      ]
    },
    "customs": {
      "text": "祭灶、扫尘、准备过年。",
      "sources": [
        {
          "title": "春节古时称“元旦”",
          "publisher": "北京市人民政府",
          "url": "https://www.beijing.gov.cn/renwen/pjsx/201902/t20190201_1874837.html",
          "accessedAt": "2026-10-25"
        }
      ]
    }
  },
  {
    "id": "new-years-eve",
    "name": "除夕",
    "rule": {
      "calendar": "lunar-eve"
    },
    "description": {
      "text": "农历一年的最后一天，可能是腊月二十九或三十。",
      "sources": [
        {
          "title": "春节",
          "publisher": "北京市人民政府",
          "url": "https://www.beijing.gov.cn/renwen/zt/wmdjr/cj/202303/t20230314_2936365.html",
          "accessedAt": "2026-10-25"
        }
      ]
    },
    "origin": {
      "text": "是辞旧迎新年节文化的重要组成部分，与家族团聚和岁末仪式相联系。",
      "sources": [
        {
          "title": "春节",
          "publisher": "北京市人民政府",
          "url": "https://www.beijing.gov.cn/renwen/zt/wmdjr/cj/202303/t20230314_2936365.html",
          "accessedAt": "2026-10-25"
        }
      ]
    },
    "customs": {
      "text": "吃年夜饭、守岁，迎接新年。",
      "sources": [
        {
          "title": "春节",
          "publisher": "北京市人民政府",
          "url": "https://www.beijing.gov.cn/renwen/zt/wmdjr/cj/202303/t20230314_2936365.html",
          "accessedAt": "2026-10-25"
        }
      ]
    }
  },
  {
    "id": "qingming",
    "name": "清明节",
    "rule": {
      "calendar": "solar-term",
      "term": "清明"
    },
    "description": {
      "text": "兼具节气与传统节日性质，日期随当年清明节气确定。",
      "sources": [
        {
          "title": "清明节",
          "publisher": "北京市人民政府",
          "url": "https://www.beijing.gov.cn/renwen/zt/wmdjr/qmj/202303/t20230303_2928277.html",
          "accessedAt": "2026-10-25"
        }
      ]
    },
    "origin": {
      "text": "在岁时发展中融合祭祖、寒食等文化传统。",
      "sources": [
        {
          "title": "清明节",
          "publisher": "北京市人民政府",
          "url": "https://www.beijing.gov.cn/renwen/zt/wmdjr/qmj/202303/t20230303_2928277.html",
          "accessedAt": "2026-10-25"
        }
      ]
    },
    "customs": {
      "text": "扫墓追思、踏青、插柳等。",
      "sources": [
        {
          "title": "清明节",
          "publisher": "北京市人民政府",
          "url": "https://www.beijing.gov.cn/renwen/zt/wmdjr/qmj/202303/t20230303_2928277.html",
          "accessedAt": "2026-10-25"
        }
      ]
    }
  },
  {
    "id": "new-year",
    "name": "元旦",
    "rule": {
      "calendar": "solar",
      "month": 1,
      "day": 1
    },
    "description": {
      "text": "公历新年的第一天。",
      "sources": [
        {
          "title": "春节古时称“元旦”",
          "publisher": "北京市人民政府",
          "url": "https://www.beijing.gov.cn/renwen/pjsx/201902/t20190201_1874837.html",
          "accessedAt": "2026-10-25"
        }
      ]
    },
    "origin": {
      "text": "“元旦”在古代曾指传统历法岁首，采用公历后与春节名称逐渐区分。",
