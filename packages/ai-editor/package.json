{
  "name": "@qingwu/ai-editor",
  "version": "0.5.0",
  "description": "青梧 - 一款面向中文用户的 AI 智能编辑器",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.13",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/styles.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles": {
      "types": "./styles.d.ts",
      "default": "./dist/styles.css"
    },
    "./clipper": {
      "types": "./dist/clipper.d.ts",
      "import": "./dist/clipper.js",
      "require": "./dist/clipper.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "styles.d.ts",
    "dist/*.js",
    "dist/*.cjs",
    "dist/*.d.ts",
    "dist/styles.css",
    "dist/editor",
    "dist/components",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.config.lib.ts && tsc -p tsconfig.build.json",
    "build:app": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "biome lint ./src",
    "format": "biome format ./src --write",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "beautiful-mermaid": "^1.1.3",
    "cmdk": "^1.1.1",
    "dompurify": "^3.4.12",
    "highlight.js": "~11.11.0",
    "lowlight": "^3.3.0",
    "tiptap-markdown": "0.9",
    "xgplayer": "^3.0.26"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^4.0.18",
    "@biomejs/biome": "^2.5.5",
    "@file-viewer/core": "2.2.2",
    "@file-viewer/react": "2.2.2",
    "@file-viewer/renderer-archive": "2.2.2",
    "@file-viewer/renderer-pdf": "2.2.2",
    "@file-viewer/renderer-presentation": "2.2.2",
    "@file-viewer/renderer-spreadsheet": "2.2.2",
    "@file-viewer/renderer-text": "2.2.2",
    "@file-viewer/renderer-word": "2.2.2",
    "@file-viewer/vite-plugin": "2.2.2",
    "@tailwindcss/postcss": "^4.3.3",
