{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationDir": "./dist",
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": [
    "src/vite-env.d.ts",
    "src/types/**/*",
    "src/index.ts",
    "src/clipper.ts",
    "src/editor/**/*",
    "src/components/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "src/main.tsx",
    "src/App.tsx",
    "src/components/demo-content.ts"
  ]
}
