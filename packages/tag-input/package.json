{
  "name": "@qingwu/tag-input",
  "version": "0.6.0",
  "description": "Framework-agnostic tag quick-insert input for Qingwu UI — input + tag chip bar, click/Enter to insert, auto-hide inserted tags, layoutChips-powered expand/collapse",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": [
    "./dist/style.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node -e \"require('fs').cpSync('src/style.css','dist/style.css')\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "size-limit"
  },
  "dependencies": {
    "@qingwu/text-layout": "^0.6.0"
  },
  "devDependencies": {
    "@qingwu/tsconfig": "workspace:*",
    "@size-limit/preset-small-lib": "^13.0.1",
    "happy-dom": "^20.11.1",
    "size-limit": "^13.0.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "size-limit": [
    {
      "path": "dist/index.mjs",
      "limit": "6 kB"
    }
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/apricotdream/qingwu-ui.git",
    "directory": "packages/tag-input"
  },
  "homepage": "https://github.com/apricotdream/qingwu-ui#readme",
  "bugs": "https://github.com/apricotdream/qingwu-ui/issues",
  "keywords": [
    "tag",
    "tag-input",
    "chips",
    "quick-insert",
    "input",
    "headless",
    "framework-agnostic",
    "keyboard-navigation",
    "ui-component",
    "qingwu"
  ],
  "author": "Qingwu Team",
  "engines": {
    "node": ">=20"
  }
}
