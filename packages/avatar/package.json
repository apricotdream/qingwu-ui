{
  "name": "@qingwu-ui/avatar",
  "version": "0.9.0-beta.1",
  "description": "青梧 UI 头像编辑器 —— 点击头像即可裁剪、缩放、旋转与圆角调节，本地导出 Blob 与 dataURL，零依赖",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": [
    "./dist/style.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node -e \"require('fs').cpSync('src/style.css','dist/style.css')\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "size-limit"
  },
  "devDependencies": {
    "@qingwu-ui/tsconfig": "workspace:*",
    "@size-limit/preset-small-lib": "^13.0.1",
    "happy-dom": "^20.11.1",
    "size-limit": "^13.0.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "size-limit": [
    {
      "path": "dist/index.mjs",
      "limit": "10 kB"
    }
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/apricotdream/qingwu-ui.git",
    "directory": "packages/avatar"
  },
  "homepage": "https://github.com/apricotdream/qingwu-ui#readme",
  "bugs": "https://github.com/apricotdream/qingwu-ui/issues",
  "keywords": [
    "avatar",
    "profile",
    "image-editor",
    "crop",
    "rotate",
    "zoom",
    "qingwu"
  ],
  "author": "Qingwu Team",
  "engines": {
    "node": ">=20"
  }
}
