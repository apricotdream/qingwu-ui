{
  "name": "qingwu-ui",
  "description": "青梧UI —— 为中文用户而生的开源组件库：从农历黄历日历，到 AI 富文本编辑器",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "packages/*",
    "packages/*/*",
    "!packages/ai-editor/extension",
    "tooling/*",
    "examples/*"
  ],
  "scripts": {
    "build": "turbo build --filter='!qingwu-web-clipper'",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "size": "turbo size",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:staged": "biome check --staged",
    "hooks:install": "git config core.hooksPath .githooks",
    "ci": "biome check . && turbo build typecheck test size",
    "publish-check": "bun tooling/publish-check/index.mjs",
    "publish-check:fix": "bun tooling/publish-check/index.mjs --fix",
    "release": "turbo build --filter='./packages/*' && bun run publish-check",
    "serve": "bun run serve.ts",
    "push:all": "git push origin HEAD && git push github HEAD"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "turbo": "^2.10.6",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/apricotdream/qingwu-ui.git"
  },
  "homepage": "https://github.com/apricotdream/qingwu-ui#readme",
  "bugs": "https://github.com/apricotdream/qingwu-ui/issues",
  "keywords": [
    "calendar",
    "date-picker",
    "lunar-calendar",
    "chinese-calendar",
    "solar-terms",
    "headless",
    "framework-agnostic",
    "ui-component",
    "accessibility",
    "ai-editor",
    "rich-text",
    "editor",
    "tiptap",
    "markdown",
    "ai-writing",
    "qingwu"
  ],
  "author": "Qingwu Team",
  "engines": {
    "node": ">=20"
  }
}
