#!/bin/sh
# 青梧UI 新代码类型门槛（TS7 严格化改造的防线）
#
# 机制：biome check --staged 只检查本次暂存(staged)的文件，
#       存量债务文件已通过 biome.json 的 overrides 名单豁免（"存量永久豁免"），
#       新代码/被修改的新增代码出现 any / 非空断言 ! / 格式错误时会在此被拦下。
#
# 三条规则（biome.json 已提升为 error）：
#   - lint/suspicious/noExplicitAny
#   - lint/suspicious/noImplicitAnyLet
#   - lint/style/noNonNullAssertion
#
# 安装：bun run hooks:install  （等价于 git config core.hooksPath .githooks）
# 跳过：git commit --no-verify（不推荐，仅限紧急情况）

if git diff --cached --quiet; then
  # 无暂存变更（如 git commit --amend 复用已提交内容），无需检查
  exit 0
fi

if ! bun run lint:staged; then
  echo ""
  echo "❌ pre-commit 门槛未通过：暂存文件中存在 any / 非空断言 / 格式错误。"
  echo "   请修复后重新 git add + commit；"
  echo "   确属存量债务文件请勿改动其类型标注（豁免名单见 biome.json overrides）。"
  exit 1
fi

exit 0
